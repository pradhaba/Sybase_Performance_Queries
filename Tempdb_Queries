-- Shows all login and application bindings currently in effect
exec sp_tempdb "show", "login"
go

-- Shows which databases belong to which groups
exec sp_tempdb "show", "db"
go
exec sp_tempdb "create", "tempdb_heavy_group"
go
exec sp_tempdb "add", "tempdb_2", "tempdb_heavy_group"
go
-- Binds the login 'reports_user' to the 'tempdb_heavy_group'
exec sp_tempdb "bind", "LG", "reports_user", "GR", "tempdb_heavy_group"
go
-- Binds 'sa' to a specific 'admin_tempdb'
exec sp_tempdb "bind", "LG", "sa", "DB", "admin_tempdb"
go
exec sp_tempdb "bind", "AP", "my_web_app", "GR", "default"
go
exec sp_tempdb "unbind", "LG", "reports_user"
go
-- Abort Log-Suspended Sessions: If tempdb is completely stuck because the log is full (Error 1105), you can use the lct_admin function to kill sessions specifically waiting on log space:
-- Use dbid 2 for the system tempdb
select lct_admin("abort", 0, 2)
go
-- Monitor tempdb (replace 'tempdb' with your specific tempdb name if using multiple)
exec sp_object_stats "00:01:00", "tempdb"
go
-- Get the long running query details in tempdb.
SELECT spid, dbname(dbid) AS db_name, starttime FROM master..syslogshold WHERE dbid = db_id("tempdb");

