-- Identify sessions consuming tempdb space
select spid, loggedindatetime, (@@maxpagesize * convert(int, pssinfo(spid, "tempdb_pages"))) / 1024 as USAGE_IN_KB
from master..sysprocesses where convert(int, pssinfo(spid, "tempdb_pages")) > 0 order by USAGE_IN_KB desc
go
